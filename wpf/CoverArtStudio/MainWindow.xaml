<Window x:Class="JubileeCoverArtStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Jubilee Cover Art Studio" Height="900" Width="1560"
        Icon="app.ico"
        Background="#1b1e28">
    <Window.Resources>
        <!-- ====================================================================
             THE HOUSE CHROME.

             Lifted from wpf/MainWindow.xaml (JubileePraise Studio) so the two
             applications are visibly the same tool with two jobs, rather than two
             tools. Every colour, radius and font size below is that window's,
             unchanged: #1b1e28 ground, #12141c wells, #232733 panel, #E6AC00
             house yellow, #2c3040 hairlines.
             ==================================================================== -->

        <!-- Tab chrome that reads on the dark panel. WPF's default tab headers
             are light grey on light grey and vanish against #232733. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9aa0ad" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="#12141c" BorderBrush="#2c3040"
                                BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2b3040" />
                                <Setter Property="Foreground" Value="#E6AC00" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1f2331" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ SCROLLBARS ============================
             WPF's stock ScrollBar is the Aero one: a wide light-grey trough with
             two arrow buttons at the ends. On a #12141c panel it is the single
             brightest thing on screen and it looks like it belongs to a different
             application, which it does.

             These are implicit styles (no x:Key), so every ScrollViewer, ListBox
             and TextBox in the window picks them up without being told. The arrow
             RepeatButtons are kept, because they still page when clicked, but
             rendered as nothing: removing them from the template entirely breaks
             the Track's arithmetic in some layouts. -->
        <Style TargetType="RepeatButton" x:Key="ScrollPageButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb" x:Key="ScrollThumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="#39415380" CornerRadius="4" Margin="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#4d566c" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#E6AC00" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="11" />
            <Setter Property="MinWidth" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="11" />
                    <Setter Property="MinHeight" Value="11" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====================== LIST ROWS: THE DARK ITEM ======================
             🔴 SETTING Foreground ON THE ListBox IS NOT ENOUGH, and this style is
             the fix for a bug that made every worklist unreadable: black text on
             the near-black well.

             Foreground is an inherited property, so `<Setter Property="Foreground">`
             on the parent ListBox looks like it should reach the row. It does not.
             The system theme's OWN ListBoxItem style sets Foreground explicitly to
             SystemColors.ControlTextBrush — which is black — and an explicit setter
             on the item beats a value inherited from its parent. Every row therefore
             painted black on #12141c and the list looked empty, while selection and
             the preview pane still worked because the DATA was fine all along.

             So the colour has to be set on the ITEM, which is what this does. Note
             what is deliberately NOT done: the title TextBlock in the templates
             below is left with no Foreground of its own. A local value there would
             beat this style and freeze the row at one colour, which would break the
             selected state — the row has to be able to change colour when picked.

             Selection is a slate fill plus an amber bar down the left edge, rather
             than the amber FILL used for ComboBox rows. A worklist row also carries
             a status tick whose colour is bound per-row — amber for "in review",
             green for "done this session" — and an amber fill would swallow the
             amber tick whole. -->
        <Style TargetType="ListBoxItem" x:Key="DarkListItem">
            <Setter Property="Foreground" Value="#dfe4ee" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1b1f2b" />
                            </Trigger>
                            <!-- Last, so it wins over hover: a selected row that is
                                 also hovered must still read as selected. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2b3142" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6AC00" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Worklist rows. Two columns rather than one string, so the tick can be
             coloured independently of the title: a tick earned in THIS session is
             green, one inherited from a previous run is muted. A single string
             cannot carry two colours. -->
        <Style TargetType="ListBox" x:Key="JobList">
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkListItem}" />
            <Setter Property="Background" Value="#12141c" />
            <Setter Property="Foreground" Value="#dfe4ee" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Mark}"
                                       Foreground="{Binding MarkBrush}" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The gallery list in the Image Studio view. Same well as JobList, but
             each row carries its own thumbnail: a free generation has no album to
             identify it by, so the picture IS the label and a text-only row would
             be unreadable after three of them. -->
        <Style TargetType="ListBox" x:Key="GalleryList">
            <!-- Same fix as JobList: without it the gallery's titles are black on
                 the near-black well. Only the grey Detail line, which sets its own
                 colour, was ever visible here. -->
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkListItem}" />
            <Setter Property="Background" Value="#12141c" />
            <Setter Property="Foreground" Value="#dfe4ee" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="3"
                                    Background="#1b1e28" BorderBrush="#2c3040" BorderThickness="1">
                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Foreground="#6f7684" FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The rail buttons. RadioButton rather than ToggleButton so the three
             are mutually exclusive without a line of code: a GroupName does what
             hand-managed IsChecked juggling would otherwise get wrong the first
             time a fourth view is added.

             Round is a CornerRadius of exactly half the 40px box. The glyphs come
             from Segoe MDL2 Assets, which ships with Windows 10 and 11; the app
             already requires a WebView2 runtime of that vintage, so there is no
             new dependency here.

             Trigger ORDER is load-bearing. IsMouseOver is declared first and
             IsChecked second, because the later trigger wins in WPF: reversed,
             hovering the active button would repaint it as inactive. -->
        <Style TargetType="RadioButton" x:Key="RailButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#9aa0ad" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Disc" Background="#1b1e28" CornerRadius="20"
                                BorderBrush="#2c3040" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#2b3040" />
                                <Setter Property="Foreground" Value="#dfe4ee" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#E6AC00" />
                                <Setter TargetName="Disc" Property="BorderBrush" Value="#E6AC00" />
                                <Setter Property="Foreground" Value="#12141c" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ordinary buttons: Refresh, Stop, the folder openers. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2b3040" />
            <Setter Property="Foreground" Value="#dfe4ee" />
            <Setter Property="BorderBrush" Value="#3a4050" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#39415a" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one yellow button per view. There is exactly one thing each view
             does, and this is what it looks like. -->
        <Style TargetType="Button" x:Key="GenerateButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E6AC00" />
            <Setter Property="Foreground" Value="#12141c" />
            <Setter Property="BorderBrush" Value="#E6AC00" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD24A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text inputs: the settings paths, the generation location, and the
             Image Studio prompt box. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12141c" />
            <Setter Property="Foreground" Value="#dfe4ee" />
            <Setter Property="CaretBrush" Value="#E6AC00" />
            <Setter Property="BorderBrush" Value="#2c3040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectionBrush" Value="#E6AC00" />
        </Style>

        <!-- ComboBox, FULLY RETEMPLATED, and it has to be. Setting Background on
             a WPF ComboBox does not reach the closed state: the default template
             paints its own ToggleButton chrome and ignores the property, which is
             why an unstyled one stays white with white text and is unreadable.
             The only way to own the closed box is to own the template. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#12141c" />
            <Setter Property="Foreground" Value="#dfe4ee" />
            <Setter Property="BorderBrush" Value="#2c3040" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <!-- The row highlight is drawn by ComboBoxItem's template, not
                         by the ComboBox, so Background/Foreground on the parent
                         cannot reach it. -->
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#12141c" />
                        <Setter Property="Foreground" Value="#dfe4ee" />
                        <Setter Property="Padding" Value="7,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E6AC00" />
                                            <Setter Property="Foreground" Value="#12141c" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E6AC00" />
                                            <Setter Property="Foreground" Value="#12141c" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#12141c" BorderBrush="#2c3040" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="18" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Column 0 is left empty: the ContentPresenter below
                                                     draws the selected text over it, so the label and
                                                     the chrome cannot disagree about colour. -->
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#9aa0ad" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,22,0" VerticalAlignment="Center"
                                              TextElement.Foreground="#dfe4ee" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="#12141c" BorderBrush="#3a4050" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="420">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Toggle" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#c9cede" />
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#9aa0ad" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </Window.Resources>

    <!-- Outer shell: the header band, then the four columns.
         The band spans the full width above all of them, so the brand and the
         scope line are never hidden by a splitter drag and never scroll away. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12141c" BorderBrush="#2c3040" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="12,0,12,0" Height="44">
                <!-- The Jubilee circle, at the size the header band allows. Same
                     mark as the taskbar icon, so the window and its button on the
                     bar are recognisably one thing. -->
                <Image DockPanel.Dock="Left" Source="app.ico" Width="26" Height="26"
                       VerticalAlignment="Center" Margin="0,0,9,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock DockPanel.Dock="Left" Text="Jubilee Cover Art Studio"
                           Foreground="#E6AC00" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="HeaderScope" DockPanel.Dock="Left" Text=""
                           Foreground="#6f7684" FontSize="11" VerticalAlignment="Center"
                           Margin="12,2,0,0" TextTrimming="CharacterEllipsis" />

                <!-- Right to left: the picker sits hard against the edge, its
                     label immediately to its left. -->
                <ComboBox x:Name="TenantPicker" DockPanel.Dock="Right"
                          Width="168" Height="26" VerticalAlignment="Center"
                          SelectionChanged="TenantPicker_SelectionChanged"
                          ToolTip="Which site's catalogue the Album Covers worklist is scoped to. Read from app/web/lib/tenants.ts, not maintained here. The Image Studio is unscoped — it writes wherever its output folder points." />
                <TextBlock DockPanel.Dock="Right" Text="Website"
                           Foreground="#9aa0ad" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="6" />
                <!-- The DEFAULT, not a fixed width: the splitter to its left
                     resizes it and the width is remembered in coverart.config.json.
                     MinWidth stops a drag from hiding the panel somewhere
                     unrecoverable. -->
                <ColumnDefinition x:Name="PanelCol" Width="360" MinWidth="280" />
                <!-- The rail. Fixed: it holds three 40px discs and nothing else. -->
                <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>

            <!-- ==================== THE LEFT PANE: THE BROWSER ====================
                 A real WebView2 (Edge/Chromium) pointed at ChatGPT. You log in by
                 hand — a genuine browser, so the human check passes normally — and
                 the app then drives YOUR authenticated session.

                 Browser above, log below, splitter between. The log gets the full
                 pane width, which is what a log of file paths and prompt fragments
                 actually needs. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="LogRow" Height="170" MinHeight="52" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <wv2:WebView2 x:Name="Wv" />

                    <!-- Sits over the browser until it has initialised, so a slow
                         first paint shows a labelled panel rather than a black
                         rectangle the user cannot interpret. Collapsed by
                         InitAsync; left visible with an error line if WebView2
                         never starts. -->
                    <Border x:Name="BrowserVeil" Background="#12141c">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="72" Height="72" Opacity="0.85"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Jubilee Cover Art Studio" Foreground="#E6AC00" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock x:Name="VeilStatus" Text="Starting the browser…" Foreground="#6f7684"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Height="6" HorizontalAlignment="Stretch" Background="#2c3040"
                              ShowsPreview="False" />

                <Border Grid.Row="2" Background="#12141c" BorderBrush="#2c3040" BorderThickness="0,1,0,0">
                    <!-- #a8f0c0 — the terminal green every Jubilee studio writes its
                         log in, matching wpf/MainWindow.xaml (JubileePraise Studio).
                         This file was ported from that one and arrived carrying
                         #a8b0c0, a slate grey one character away from the green;
                         corrected 2026-09-10. The log is machine output — what is
                         running behind the scenes — and it reads as that. -->
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent"
                             Foreground="#a8f0c0" BorderThickness="0" FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" Padding="8,6" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Width="6" VerticalAlignment="Stretch" Background="#2c3040"
                          ShowsPreview="False" />

            <!-- ======================== THE RIGHT PANEL ========================
                 One of three views, chosen by the rail. -->
            <Grid Grid.Column="2" Background="#232733">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1b1e28" BorderBrush="#2c3040" BorderThickness="0,0,0,1" Height="30">
                    <TextBlock x:Name="PanelTitle" Text="Album Covers" Foreground="#dfe4ee"
                               FontSize="13" FontWeight="SemiBold" Margin="12,0,12,0"
                               VerticalAlignment="Center" />
                </Border>

                <!-- ========================= ALBUM COVERS =========================
                     Finds albums on the music drive with no artwork/<CODE>.png,
                     builds each one a prompt from its persona's model file in
                     .models plus the album's own content, and generates the picture
                     through the browser on the left.

                     Ported from wpf/CoverImages.cs (JubileePraise Studio). -->
                <Grid x:Name="ViewCovers" Grid.Row="1">
                    <!-- The worklist and the preview are BOTH star rows, and that
                         is what keeps the Generate button on screen.

                         A Grid gives every Auto row its full desired height first
                         and lets the last ones fall off the bottom when the total
                         does not fit. The preview is square — at a 380px panel it
                         wants ~380px of height — so with the preview in an Auto row
                         the panel overflows by roughly the height of one button,
                         and the button it loses is the yellow one.

                         Two star rows share whatever is left AFTER the fixed
                         controls, so both shrink under pressure and the button is
                         never the thing that gives. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="64" />
                        <RowDefinition Height="3*" MinHeight="80" MaxHeight="330" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Language scope, and it sits at the very top because it
                         governs everything below it — the list AND what Generate
                         sweeps.

                         Checked by default. A translated edition is not a new
                         picture: the house pattern is that the RO/JA/KO twin reuses
                         its English original's photograph and swaps only the title
                         text, so generating one from scratch would produce a second,
                         different cover for the same album and break the pairing. -->
                    <CheckBox x:Name="ChkCoversEnglishOnly" Grid.Row="0" IsChecked="True"
                              FontSize="11" Margin="10,8,10,2"
                              Checked="ChkCoversEnglishOnly_Click" Unchecked="ChkCoversEnglishOnly_Click"
                              ToolTip="Lists only albums whose code ends in EN (or in a digit, which means no language field at all). Untick to include every localised edition.">
                        <TextBlock Text="Display English albums only" TextWrapping="Wrap" />
                    </CheckBox>

                    <!-- Refresh and Stop together, because they are the two things
                         you reach for WHILE a run is going. Refresh also re-reads
                         .models, so editing a brief and pressing it changes the
                         next image. -->
                    <Grid Grid.Row="1" Margin="10,6,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCoversRefresh" Grid.Column="0" Content="Refresh" Height="28" Width="66"
                                VerticalAlignment="Top" Click="BtnCoversRefresh_Click"
                                ToolTip="Re-reads the music drive and the .models briefs." />
                        <Button x:Name="BtnCoversStop" Grid.Column="2" Content="Stop" Height="28" Width="56"
                                VerticalAlignment="Top" Click="BtnStop_Click" IsEnabled="False"
                                ToolTip="Halts after the cover currently generating. Nothing in flight is lost." />
                        <CheckBox x:Name="ChkCoversShowAll" Grid.Column="3"
                                  FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Checked="ChkCoversShowAll_Click" Unchecked="ChkCoversShowAll_Click">
                            <TextBlock Text="Show albums that already have artwork" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>

                    <!-- One persona at a time, or all twelve. An album belongs to
                         exactly one voice, and a persona's covers are a single
                         visual system, so generating a voice at a time is how the
                         set stays coherent. -->
                    <StackPanel Grid.Row="2" Margin="10,0,10,8">
                        <TextBlock Text="Persona" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CmbCoverPersona" Height="26" FontSize="12"
                                  SelectionChanged="CmbCoverPersona_SelectionChanged"
                                  ToolTip="Whose albums to list. Each persona's covers are built from its own model file in .models." />

                        <!-- Four by default, because one interpretation of a title
                             is a coin toss. Each draft attacks the album from a
                             different angle — celebration, majesty, wonder,
                             intimacy — so the clever-but-lifeless reading is one of
                             four rather than the only one. -->
                        <TextBlock Text="Drafts per album" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                        <ComboBox x:Name="CmbDrafts" Height="26" FontSize="12"
                                  ToolTip="How many different angles to generate per album. Four gives celebration, majesty, wonder and intimacy.">
                            <ComboBoxItem Content="4 — all four angles" Tag="4" IsSelected="True" />
                            <ComboBoxItem Content="2 — celebration and majesty" Tag="2" />
                            <ComboBoxItem Content="1 — celebration only" Tag="1" />
                        </ComboBox>
                    </StackPanel>

                    <ListBox x:Name="LstCovers" Grid.Row="3" Style="{StaticResource JobList}" Margin="10,0,10,8"
                             SelectionChanged="LstCovers_SelectionChanged" />

                    <!-- Square, because covers are. Shows the file on disk, so a
                         run in flight shows each cover as it lands. -->
                    <Border Grid.Row="4" Margin="10,0,10,8" Background="#12141c"
                            BorderBrush="#2c3040" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <!-- The picture takes a STAR row, not Auto: inside a
                                 height-capped border an Auto row would still demand
                                 the Viewbox's natural size and push the caption
                                 out. -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                <Grid Width="240" Height="240">
                                    <TextBlock x:Name="CoverPreviewEmpty" Foreground="#4d566c" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="16,0"
                                               Text="Select an album to preview its cover" />
                                    <Image x:Name="CoverPreviewImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="CoverPreviewCaption" Grid.Row="1" Foreground="#9aa0ad" FontSize="10"
                                       Margin="8,6,8,7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="46" Text="" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="5" Margin="10,0,10,8">
                        <CheckBox x:Name="ChkCoverChrome" IsChecked="True" FontSize="11" Margin="0,0,0,6"
                                  ToolTip="Draws the border, the persona wordmark and the album title onto the finished photograph, using the title from album.meta.json. Untick to save the bare picture.">
                            <TextBlock Text="Draw the house chrome (border, wordmark, album title)" TextWrapping="Wrap" />
                        </CheckBox>
                        <!-- Side by side rather than stacked. Every fixed pixel down
                             here comes straight off the two star rows above. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCoversOpen" Grid.Column="0" Content="Album folder" Height="26" FontSize="11"
                                    Click="BtnCoversOpen_Click"
                                    ToolTip="Opens the review folder when this album has a cover waiting there, and the album folder otherwise." />
                            <Button x:Name="BtnReviewOpen" Grid.Column="2" Content="Review folder" Height="26" FontSize="11"
                                    Click="BtnReviewOpen_Click"
                                    ToolTip="Opens review\&lt;Persona&gt;, where generated covers land for approval." />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="BtnCoversGenerate" Grid.Row="6" Content="Generate Covers"
                            Style="{StaticResource GenerateButton}" Margin="10,0,10,12"
                            Click="BtnCoversGenerate_Click"
                            ToolTip="Generates a cover for every listed album that has no artwork yet. Drafts land in review/ for approval — never straight onto the music drive." />
                </Grid>
                <!-- ======================= END ALBUM COVERS ======================= -->

                <!-- ========================= IMAGE STUDIO =========================
                     Free-form generation. Same browser, same runner, same save
                     path — but the job comes from the prompt box instead of from an
                     album, so it will make anything: a hero image, a thumbnail, a
                     poster, a texture.

                     THE OUTPUT FOLDER IS ITS OWN SETTING and defaults OUTSIDE the
                     catalogue. A free generation has no album to belong to, and
                     writing one into a music-drive artwork folder would put an
                     unreviewed picture where the publish pipeline reads approved
                     masters from. -->
                <Grid x:Name="ViewStudio" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="70" />
                        <RowDefinition Height="3*" MinHeight="80" MaxHeight="300" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,8,10,6">
                        <TextBlock Text="What to make" Style="{StaticResource FieldLabel}" />
                        <!-- Deliberately tall and wrapping. The prompt is the whole
                             job here, and a single-line box would make anything past
                             a sentence unreadable while typing it. It is flattened
                             to one line on send — see Studio.cs. -->
                        <TextBox x:Name="TxtPrompt" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"
                                 ToolTip="Describe the picture. Newlines are fine — the prompt is flattened to a single line before it is sent, because the ChatGPT composer treats a newline as a paragraph break and only the last paragraph would survive." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Shape" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CmbShape" Height="26" FontSize="12"
                                      ToolTip="The aspect ratio demanded in the prompt's last clause, which is the instruction the web UI honours most reliably.">
                                <ComboBoxItem Content="Square 1:1 (cover)" Tag="1:1" IsSelected="True" />
                                <ComboBoxItem Content="Wide 16:9 (hero, banner)" Tag="16:9" />
                                <ComboBoxItem Content="Portrait 3:4 (poster)" Tag="3:4" />
                                <ComboBoxItem Content="Tall 9:16 (story, reel)" Tag="9:16" />
                                <ComboBoxItem Content="Classic 4:3" Tag="4:3" />
                                <ComboBoxItem Content="Let ChatGPT decide" Tag="" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="How many" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CmbCount" Height="26" FontSize="12"
                                      ToolTip="Each one is a separate turn with its own conversation pacing. They are numbered -1, -2, -3 … on disk.">
                                <ComboBoxItem Content="1 draft" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="2 drafts" Tag="2" />
                                <ComboBoxItem Content="4 drafts" Tag="4" />
                                <ComboBoxItem Content="6 drafts" Tag="6" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="10,0,10,6">
                        <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtStudioName" Grid.Column="0" Height="26" FontSize="12"
                                     ToolTip="Leave it empty and the name is taken from the first few words of the prompt, plus the date." />
                            <Button x:Name="BtnStudioFolder" Grid.Column="2" Content="Folder…" Height="26" FontSize="11"
                                    Click="BtnStudioFolder_Click"
                                    ToolTip="Opens the output folder in Explorer. Change where it points in Settings." />
                        </Grid>
                    </StackPanel>

                    <!-- Reference images. Optional here, unlike on a cover: a free
                         generation may have nothing to match, and forcing one would
                         make the simplest use of this view the hardest. -->
                    <StackPanel Grid.Row="3" Margin="10,0,10,6">
                        <TextBlock Text="Reference images (optional)" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RefDrop" Grid.Column="0" Background="#12141c" BorderBrush="#2c3040"
                                    BorderThickness="1" CornerRadius="3" Height="26"
                                    AllowDrop="True" Drop="RefDrop_Drop" DragOver="RefDrop_DragOver"
                                    DragLeave="RefDrop_DragLeave"
                                    ToolTip="Drop image files here, or press Add. They ride along with every draft as a style and likeness reference.">
                                <TextBlock x:Name="RefDropLabel" Text="Drop images here" Foreground="#6f7684"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="2" Content="Add" Height="26" Width="46" FontSize="11"
                                    Click="BtnRefAdd_Click" ToolTip="Pick reference images with a file dialog." />
                            <Button Grid.Column="4" Content="Clear" Height="26" Width="50" FontSize="11"
                                    Click="BtnRefClear_Click" ToolTip="Drop every reference." />
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="LstStudio" Grid.Row="4" Style="{StaticResource GalleryList}" Margin="10,0,10,8"
                             SelectionChanged="LstStudio_SelectionChanged"
                             ToolTip="Everything in the output folder, newest first. This is the gallery — it survives a restart, because it is read off disk rather than remembered." />

                    <Border Grid.Row="5" Margin="10,0,10,8" Background="#12141c"
                            BorderBrush="#2c3040" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                <Grid Width="240" Height="240">
                                    <TextBlock x:Name="StudioPreviewEmpty" Foreground="#4d566c" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="16,0"
                                               Text="Nothing generated yet" />
                                    <Image x:Name="StudioPreviewImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="StudioPreviewCaption" Grid.Row="1" Foreground="#9aa0ad" FontSize="10"
                                       Margin="8,6,8,7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="46" Text="" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnStudioRefresh" Grid.Column="0" Content="Refresh" Height="26" Width="66"
                                FontSize="11" Click="BtnStudioRefresh_Click"
                                ToolTip="Re-reads the output folder." />
                        <Button x:Name="BtnStudioStop" Grid.Column="2" Content="Stop" Height="26" Width="56"
                                FontSize="11" Click="BtnStop_Click" IsEnabled="False"
                                ToolTip="Halts after the draft currently generating." />
                        <CheckBox x:Name="ChkStudioWebp" Grid.Column="3" IsChecked="True" FontSize="11"
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  ToolTip="Re-encodes the download as WebP, which is a fraction of the bytes for the same picture. Untick to keep the original PNG or JPEG the model returned.">
                            <TextBlock Text="Save as WebP" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>

                    <Button x:Name="BtnStudioGenerate" Grid.Row="7" Content="Generate Images"
                            Style="{StaticResource GenerateButton}" Margin="10,0,10,12"
                            Click="BtnStudioGenerate_Click"
                            ToolTip="Sends the prompt, waits for each picture, and writes it into the output folder." />
                </Grid>
                <!-- ======================= END IMAGE STUDIO ======================= -->

                <!-- ========================== HERO IMAGES ==========================
                     The square cover, reverse-engineered into 16:9.

                     The worklist is every album that HAS a cover, because here the
                     cover IS the brief: it is attached as the one reference and the
                     prompt asks for the same photograph WIDENED — same person, same
                     wardrobe, same light — with the sleeve chrome gone.

                     🔴 THESE ARE WRITTEN INTO THE WEBSITE, not into review/. A hero
                     has no promotion step and nothing reads the folder to decide
                     whether an album is finished, so it lands where the site serves
                     static files from: app/web/public/images/heroes/<persona>/<CODE>.webp
                     Nothing is ever overwritten — a second draft takes "(2)". -->
                <Grid x:Name="ViewHero" Grid.Row="1" Visibility="Collapsed">
                    <!-- Same two-star-row shape as the covers view, and for the same
                         reason: the preview must shrink under pressure so the yellow
                         Generate button is never the control that falls off. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="64" />
                        <RowDefinition Height="3*" MinHeight="80" MaxHeight="300" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="ChkHeroesEnglishOnly" Grid.Row="0" IsChecked="True"
                              FontSize="11" Margin="10,8,10,2"
                              Checked="ChkHeroesEnglishOnly_Click" Unchecked="ChkHeroesEnglishOnly_Click"
                              ToolTip="A localised edition reuses its English original's photograph, so it would produce the same hero twice. Untick to include them anyway.">
                        <TextBlock Text="Display English albums only" TextWrapping="Wrap" />
                    </CheckBox>

                    <Grid Grid.Row="1" Margin="10,6,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnHeroesRefresh" Grid.Column="0" Content="Refresh" Height="28" Width="66"
                                VerticalAlignment="Top" Click="BtnHeroesRefresh_Click"
                                ToolTip="Re-reads the music drive and the heroes folder." />
                        <Button x:Name="BtnHeroesStop" Grid.Column="2" Content="Stop" Height="28" Width="56"
                                VerticalAlignment="Top" Click="BtnStop_Click" IsEnabled="False"
                                ToolTip="Halts after the hero currently generating. Nothing in flight is lost." />
                        <CheckBox x:Name="ChkHeroesShowAll" Grid.Column="3"
                                  FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Checked="ChkHeroesShowAll_Click" Unchecked="ChkHeroesShowAll_Click">
                            <TextBlock Text="Show albums that already have a hero" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="10,0,10,8">
                        <TextBlock Text="Persona" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CmbHeroPersona" Height="26" FontSize="12"
                                  SelectionChanged="CmbHeroPersona_SelectionChanged"
                                  ToolTip="Whose albums to list. Every album with cover art becomes a job; its own cover is the reference." />

                        <!-- One by default, unlike covers. A cover is a coin toss on
                             how a title reads and wants four angles; a hero is a
                             reframing of a photograph that already exists, so the
                             first one is usually right. -->
                        <TextBlock Text="Drafts per album" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                        <ComboBox x:Name="CmbHeroDrafts" Height="26" FontSize="12"
                                  ToolTip="How many framings to generate per album — the establishing wide, the cinematic two-thirds, and the moment either side.">
                            <ComboBoxItem Content="1 — the establishing wide" Tag="1" IsSelected="True" />
                            <ComboBoxItem Content="2 — wide and two-thirds" Tag="2" />
                            <ComboBoxItem Content="3 — all three framings" Tag="3" />
                        </ComboBox>
                    </StackPanel>

                    <ListBox x:Name="LstHeroes" Grid.Row="3" Style="{StaticResource JobList}" Margin="10,0,10,8"
                             SelectionChanged="LstHeroes_SelectionChanged" />

                    <!-- 16:9, because heroes are — and because seeing the square
                         cover in a wide box is the clearest possible statement of
                         what this view is for. -->
                    <Border Grid.Row="4" Margin="10,0,10,8" Background="#12141c"
                            BorderBrush="#2c3040" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                <Grid Width="320" Height="180">
                                    <TextBlock x:Name="HeroPreviewEmpty" Foreground="#4d566c" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="16,0"
                                               Text="Select an album to preview its hero — or its cover, which is what the hero is made from" />
                                    <Image x:Name="HeroPreviewImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="HeroPreviewCaption" Grid.Row="1" Foreground="#9aa0ad" FontSize="10"
                                       Margin="8,6,8,7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="46" Text="" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="5" Margin="10,0,10,8">
                        <!-- Off by default, and that is a safety rail rather than a
                             preference: the picture it would replace is one the live
                             site may already be serving. -->
                        <CheckBox x:Name="ChkHeroesRegenerate" FontSize="11" Margin="0,0,0,6"
                                  ToolTip="Generates again for albums that already have a hero. The existing file is NOT overwritten — the new one lands as (2).">
                            <TextBlock Text="Regenerate albums that already have a hero" TextWrapping="Wrap" />
                        </CheckBox>
                        <!-- The regeneration queue. A hero is marked by MOVING it to
                             review\_heroes-rejected, which pulls it off the site and
                             puts the album back in the queue — see Hero.cs. -->
                        <CheckBox x:Name="ChkHeroesMarkedOnly" FontSize="11" Margin="0,0,0,6"
                                  ToolTip="Queues only the albums marked ↻ — heroes pulled into review\_heroes-rejected — and not albums that simply have never had one.">
                            <TextBlock Text="Only albums marked for regeneration (↻)" TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnHeroMarkRedo" Grid.Column="0" Content="Mark for regeneration" Height="26" FontSize="11"
                                    Click="BtnHeroMarkRedo_Click"
                                    ToolTip="Pulls the selected album's hero off the site — moved, not deleted, to review\_heroes-rejected\&lt;persona&gt; — and puts the album back in the queue. The new one lands as &lt;CODE&gt;.webp." />
                            <Button x:Name="BtnHeroFolderOpen" Grid.Column="2" Content="Hero folder" Height="26" FontSize="11"
                                    Click="BtnHeroFolderOpen_Click"
                                    ToolTip="Opens app\web\public\images\heroes\&lt;persona&gt; — inside the website, servable as soon as it is written." />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="BtnHeroesGenerate" Grid.Row="6" Content="Generate Hero Images"
                            Style="{StaticResource GenerateButton}" Margin="10,0,10,12"
                            Click="BtnHeroesGenerate_Click"
                            ToolTip="Reverse-engineers each listed album's square cover into a 16:9 cinematic still with no text and no border, written into the website's images folder." />
                </Grid>
                <!-- ======================== END HERO IMAGES ======================== -->

                <!-- ============================ SETTINGS ============================
                     Where everything reads from and writes to, plus the generation
                     location. Saved to coverart.config.json beside the project,
                     which is git-ignored. -->
                <Grid x:Name="ViewSettings" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,10,10,10">
                            <TextBlock Text="Repo root" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="RepoRoot" Height="26"
                                     ToolTip="Resolved by walking up from the binary looking for core/articles/gen-articles.mjs. There is deliberately no hard-coded fallback." />

                            <TextBlock Text="Music root" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                            <TextBox x:Name="MusicRoot" Height="26"
                                     ToolTip="The album corpus. A separate volume from the repo, which is why it is a setting rather than derived from the repo root." />

                            <TextBlock Text="Studio output folder" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                            <TextBox x:Name="StudioRoot" Height="26"
                                     ToolTip="Where free generations land. Defaults to review\_studio inside the repo — outside every album's artwork folder, deliberately." />

                            <!-- Inside the website on purpose: a hero is a site asset,
                                 and the point of that view is that making one is
                                 publishing one. Moving this outside app/web/public
                                 means the pictures stop being servable. -->
                            <TextBlock Text="Hero output folder" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                            <TextBox x:Name="HeroRootBox" Height="26"
                                     ToolTip="Where 16:9 hero images land, one subfolder per persona. Defaults to app\web\public\images\heroes inside the repo, so each one is servable at /images/heroes/&lt;persona&gt;/&lt;CODE&gt;.webp the moment it is written." />

                            <TextBlock Text="Generation location" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                            <TextBox x:Name="LocationUrl" Height="26"
                                     ToolTip="The page every new conversation is opened at. Point it at a ChatGPT Project and every generation lands inside that project." />
                            <Button Content="Use the page the browser is on" Height="26" FontSize="11" Margin="0,5,0,0"
                                    Click="BtnUseLocation_Click"
                                    ToolTip="Reads the live address out of the page — CoreWebView2.Source lags behind a single-page app's client-side navigation." />

                            <Border Background="#12141c" BorderBrush="#2c3040" BorderThickness="1"
                                    CornerRadius="4" Margin="0,14,0,0" Padding="9,7">
                                <StackPanel>
                                    <TextBlock Text="The browser" Foreground="#E6AC00" FontSize="11"
                                               FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBlock Foreground="#9aa0ad" FontSize="11" TextWrapping="Wrap"
                                               Text="Log in to ChatGPT in the pane on the left. It is a real browser, so the human check passes normally, and the session is kept in this app's own profile folder — you stay logged in between runs." />
                                    <Button Content="Open ChatGPT" Height="26" FontSize="11" Margin="0,7,0,0"
                                            Click="BtnOpenChatGpt_Click" />
                                    <Button Content="Sign out of this profile" Height="26" FontSize="11" Margin="0,5,0,0"
                                            Click="BtnClearProfile_Click"
                                            ToolTip="Clears cookies and site data for the embedded browser. Takes effect immediately." />
                                </StackPanel>
                            </Border>

                            <Button Content="Save settings" Style="{StaticResource GenerateButton}"
                                    Margin="0,14,0,0" Click="BtnSaveCfg_Click" />

                            <TextBlock x:Name="AboutText" Foreground="#4d566c" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- ========================== END SETTINGS ========================== -->
            </Grid>

            <!-- ============================== THE RAIL ==============================
                 Two working views at the top, settings pinned at the bottom. -->
            <Border Grid.Column="3" Background="#12141c" BorderBrush="#2c3040" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,12,0,0">
                        <RadioButton x:Name="RailCovers" GroupName="Rail" Style="{StaticResource RailButton}"
                                     Content="&#xE7C5;" IsChecked="True" Checked="Rail_Checked"
                                     ToolTip="Album Covers — every album on the music drive with no artwork yet" />
                        <RadioButton x:Name="RailStudio" GroupName="Rail" Style="{StaticResource RailButton}"
                                     Content="&#xEB9F;" Checked="Rail_Checked"
                                     ToolTip="Image Studio — generate any picture from a prompt" />
                        <!-- The third view. Segoe MDL2 E714 (Video) rather than
                             another picture glyph: this one makes CINEMATIC
                             widescreen stills, and the rail should say which of
                             the two image views you are reaching for. -->
                        <RadioButton x:Name="RailHero" GroupName="Rail" Style="{StaticResource RailButton}"
                                     Content="&#xE714;" Checked="Rail_Checked"
                                     ToolTip="Hero Images — reverse-engineer each album's square cover into a 16:9 cinematic banner for the website" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <RadioButton x:Name="RailSettings" GroupName="Rail" Style="{StaticResource RailButton}"
                                     Content="&#xE713;" Checked="Rail_Checked"
                                     ToolTip="Settings — where this reads from and writes to" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
