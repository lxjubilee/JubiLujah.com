node_modules/
.env
.env.local
.env.*.local
dist/
build/
.next/
out/
.turbo/
*.log
.DS_Store
Thumbs.db
*.bak
*.bak-*

# Large artwork masters (persona ZIPs) — live on J:/CDN, exceed GitHub's 100MB limit
artwork/

# Next.js dev build output (JubileePraise web)
app/web/.next-dev/

# Local review dumps (per-persona artwork/review exports + zips) — 1.4 GB.
# Same class as artwork/ above: they live on J:/CDN and exceed GitHub's 100MB
# per-file limit (review.zip is ~490MB, which git push would reject outright).
review/
review.zip

# Local model scratch
.models/

# Conversation journal (machine-local): one record per Claude Code session plus
# the generated index. Prompt text lives here, so it stays out of the repo.
# CONTINUITY.md (where we left off) and DECISIONS.md (the append-only decision
# log) are hand-kept and ARE tracked — they are the part that must survive, and
# neither contains prompt text.
.claude/sessions/*.json
.claude/sessions/INDEX.md
!.claude/sessions/CONTINUITY.md
!.claude/sessions/DECISIONS.md

# The shared transcript vault. Whole conversations, verbatim — every file read
# and every value printed, secrets included. It exists so a thread held on one
# machine can be reopened on another (.claude/tools/transcripts.mjs); it must
# never reach the repo. Its README is tracked so the folder explains itself.
.claude/sessions/transcripts/*.jsonl

# Next.js production builds made into a fresh dist dir per release (NEXT_DIST_DIR=.next-<name>).
# The default .next on this network share hangs `next build` — see PUBLISH.md, 2026-09-12 and
# 2026-09-16 — so every release builds into its own folder, and none of them are source.
app/web/.next-*/
