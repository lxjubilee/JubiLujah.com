<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ImageStudio</AssemblyName>
    <RootNamespace>ArticleImageStudio</RootNamespace>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <!-- WebP re-encoding of downloaded PNGs (Apache-2.0). -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.*" />
  </ItemGroup>

</Project>
